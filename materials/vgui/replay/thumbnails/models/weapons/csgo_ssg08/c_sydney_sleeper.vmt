VertexLitGeneric
{
	"$baseTexture" 		"vgui/replay/thumbnails/models/weapons/csgo_ssg08/snip_ssg08_chromatic_color"
	"$baseTexture" 		"vgui/replay/thumbnails/models/weapons/csgo_ssg08/snip_ssg08_chromatic_normal"
	"$phongexponenttexture" "vgui/replay/thumbnails/models/weapons/csgo_ssg08/snip_ssg08_chromatic_exponent"

	"$phong" "1"
	"$phongboost" "4"
	"$phongalbedoboost" "60"
	"$phongfresnelranges" "[.8 .8 1]"
	"$basemapalphaphongmask" "1"
	"$phongalbedotint" "1"
	"$phongdisablehalflambert" "1"

	// Cloaking
	"$cloakPassEnabled" "1"
	"$sheenPassEnabled" "1"

	"$sheenmap" 		"cubemaps\cubemap_sheen001"
	"$sheenmapmask" 		"Effects\AnimatedSheen\animatedsheen0"
	"$sheenmaptint" 		"[ 1 1 1 ]"
	"$sheenmapmaskframe" 	"0"
	"$sheenindex" 		"0"

	"$yellow" "0"

	"Proxies"
	{
		"AnimatedWeaponSheen"
		{
			"animatedtexturevar" 		"$sheenmapmask"
			"animatedtextureframenumvar" 	"$sheenmapmaskframe"
			"animatedtextureframerate" 		"40"
		}
		"invis"
		{
		}
		"ModelGlowColor"
		{
			"resultVar" "$glowcolor"
		}
		"Equals"
		{
			"srcVar1"  "$glowcolor"
			"resultVar" "$selfillumtint"
		}
		"Equals"
		{
			"srcVar1"  "$glowcolor"
			"resultVar" "$color2"
		}
		"YellowLevel"
		{
			"resultVar" "$yellow"
		}
		"Multiply"
		{
			"srcVar1" "$color2"
			"srcVar2" "$yellow"
			"resultVar" "$color2"
		}
	}
}

